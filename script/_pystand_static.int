import sys
import pdf2zh.pdf2zh
import os
import babeldoc.assets.assets
import pathlib
import traceback

launcher_path = pathlib.Path(os.environ.get("PYSTAND", sys.executable))
is_desktop_launcher = launcher_path.stem.casefold() == "pdfmathtranslate-codex"
wait_for_input = False
if len(sys.argv) == 1:
    if is_desktop_launcher:
        sys.argv.append("--desktop")
    else:
        sys.argv.append("-i")
        wait_for_input = True

files = os.listdir(os.path.dirname(__file__))
for file in files:
    if file.endswith(".zip") and file.startswith("offline_assets_"):
        print("find offline_assets_zip file: ", file, " try restore...")
        babeldoc.assets.assets.restore_offline_assets_package(
            pathlib.Path(os.path.dirname(__file__))
        )

try:
    code = pdf2zh.pdf2zh.main()
    print(f"pdf2zh.pdf2zh.main() return code: {code}")
    if wait_for_input:
        input("Press Enter to continue...")
    sys.exit(code)
except Exception:
    detail = traceback.format_exc()
    print(detail)
    if sys.platform == "win32" and is_desktop_launcher:
        import ctypes

        ctypes.windll.user32.MessageBoxW(
            None,
            detail,
            "PDFMathTranslate Desktop - Startup Error",
            0x10,
        )
    elif wait_for_input:
        input("Press Enter to continue...")
    sys.exit(1)
